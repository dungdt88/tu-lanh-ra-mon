# ──────────────────────────────────────────────────────────────
#  Tủ Lạnh Ra Món — điền 3 dòng dưới là chạy đủ tính năng.
#  Copy file này thành .env.local rồi điền giá trị thật.
#  Sửa xong nhớ khởi động lại `npm run dev`.
# ──────────────────────────────────────────────────────────────

# 1) SUPABASE ─ supabase.com → project → Settings → API
#    "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
#    "anon public" key (dán cả chuỗi eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 2) GEMINI ─ aistudio.google.com/apikey → Create API key
#    Dùng cho nhận diện nguyên liệu từ ảnh tủ lạnh.
GEMINI_API_KEY=AIza...

# ──────────────────────────────────────────────────────────────
#  Phần dưới có giá trị mặc định sẵn, để trống cũng được.
# ──────────────────────────────────────────────────────────────

# Model Gemini dùng để đọc ảnh (mặc định: gemini-3.6-flash)
GEMINI_MODEL=

# Chỉ dùng cho script chạy ở máy/CI (seed, job nền). Không bao giờ đưa ra client.
SUPABASE_SERVICE_ROLE_KEY=

# Đổi endpoint Gemini khi cần test bằng server giả. Để trống là dùng endpoint thật.
GEMINI_BASE_URL=
