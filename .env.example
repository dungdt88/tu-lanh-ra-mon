# ──────────────────────────────────────────────────────────────
#  Tủ Lạnh Ra Món — điền 3 dòng dưới là chạy đủ tính năng.
#  Copy file này thành .env.local rồi điền giá trị thật.
#  Sửa xong nhớ khởi động lại `npm run dev`.
# ──────────────────────────────────────────────────────────────

# 1) SUPABASE ─ supabase.com → project → Settings → API
#    "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
#    "anon public" key (dán cả chuỗi eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 2) VERTEX AI (Google Cloud) ─ dùng cho nhận diện ảnh, trợ lý chat, kiểm duyệt
#    Cần: project có bật Vertex AI API + service account role aiplatform.user.
#    Xem docs/vertex-setup.md để làm từng bước.
#    Project ID (KHÔNG phải tên hiển thị)
GOOGLE_CLOUD_PROJECT=
#    Đường dẫn file khoá service account. BÍ MẬT, đã bị gitignore.
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json

# ──────────────────────────────────────────────────────────────
#  Phần dưới có giá trị mặc định sẵn, để trống cũng được.
# ──────────────────────────────────────────────────────────────

# Model Gemini trên Vertex (mặc định: gemini-2.5-flash)
GEMINI_MODEL=

# Vùng chạy Vertex (mặc định: asia-southeast1 - Singapore).
# Model không có ở mọi vùng, đổi vùng thì kiểm tra lại model.
GOOGLE_CLOUD_LOCATION=

# Chỉ dùng cho script chạy ở máy/CI (seed, job nền). Không bao giờ đưa ra client.
SUPABASE_SERVICE_ROLE_KEY=

# Access token có sẵn, dùng thay cho việc tự ký từ file khoá.
# Chỉ dùng khi test hoặc khi đã có token từ `gcloud auth print-access-token`.
VERTEX_ACCESS_TOKEN=

# Địa chỉ gốc của app, dùng cho link chia sẻ lên Facebook/Zalo.
# Để trống là http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
