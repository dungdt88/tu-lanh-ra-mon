    "mod:scan": "tsx scripts/moderate-scan.ts",
    "dev:lan": "next dev -H 0.0.0.0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "intro:render": "python3 scripts/intro/render.py",
    "promo:build": "python3 scripts/promo/build_scene.py",
    "promo:render": "python3 scripts/promo/build_scene.py && python3 scripts/promo/render.py",
    "test:chat": "tsx --tsconfig scripts/test/tsconfig.json scripts/test/chat-guardrails.ts",
    "test:mod": "tsx --tsconfig scripts/test/tsconfig.json scripts/test/moderation.ts",
    "test:mock": "tsx --tsconfig scripts/test/tsconfig.json scripts/test/chat-mock.ts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
